\u4e00\u914d\u8272\u3001\u5b57\u9ad4\u3001\u5716\u793a\u3001\u52d5\u756b\u3001\u684c\u5e03\u3001\u7d42\u7aef\u6a5f\u4e3b\u984c\u8207\u64cd\u4f5c\u8a2d\u5b9a\u3002"},{"location":"linux/00-linux-desktop-enviroment/#_1","title":"\u684c\u9762\u74b0\u5883\u7d44\u5408\u6bd4\u8f03","text":"\u5b9a\u4f4d \u4f5c\u696d\u7cfb\u7d71 \u684c\u9762\u74b0\u5883\uff0f\u8996\u7a97\u7ba1\u7406\u5668 \u684c\u9762\u5c0f\u5de5\u5177\uff0f\u4ecb\u9762 Rice\uff0fDotfiles \u958b\u7bb1\u5373\u7528 Linux Mint XFCE Waybar\u3001Rofi\u3001Wlogout\u3001Picom \u2014 \u5b8c\u6574\u684c\u9762 CachyOS KDE Plasma \u2014 \u2014 \u81ea\u7531\u7d44\u88dd CachyOS Hyprland Waybar\u3001Rofi\u3001Wlogout \u81ea\u884c\u914d\u7f6e \u5957\u4ef6\u6574\u5408 CachyOS Hyprland Caelestia Dot bitzdots\u3001hyprland-glassmorphism \u5957\u4ef6\u6574\u5408 CachyOS Niri Noctalia hqhoangvuong/hyprland-cachyos-setup\u3001ML4W OS Rice \u7bc4\u4f8b \u2014 Hyprland \u2014 end-4 / dots-hyprland"},{"location":"linux/00-linux-desktop-enviroment/#_2","title":"\u540d\u8a5e\u5099\u5fd8","text":"<ul> <li>Linux \u767c\u884c\u7248\uff1a \u4f8b\u5982 Linux Mint\u3001CachyOS\uff0c\u63d0\u4f9b\u4f5c\u696d\u7cfb\u7d71\u57fa\u790e\u8207\u5957\u4ef6\u7ba1\u7406\u3002</li> <li>\u684c\u9762\u74b0\u5883\uff08DE\uff09\uff1a \u4f8b\u5982 XFCE\u3001KDE Plasma\uff0c\u901a\u5e38\u6574\u5408\u591a\u7a2e\u684c\u9762\u529f\u80fd\u3002</li> <li>\u8996\u7a97\u7ba1\u7406\u5668\uff08WM\uff09\uff1a \u8ca0\u8cac\u8996\u7a97\u7684\u6392\u5217\u3001\u79fb\u52d5\u8207\u7ba1\u7406\uff0c\u4f8b\u5982 Hyprland\u3001Niri\u3002</li> <li>\u684c\u9762\u5c0f\u5de5\u5177\uff1a \u4f8b\u5982 Waybar\uff08\u72c0\u614b\u5217\uff09\u3001Rofi\uff08\u555f\u52d5\u5668\uff09\u3001Wlogout\uff08\u767b\u51fa\u9078\u55ae\uff09\u3002</li> <li>Rice\uff0fDotfiles\uff1a \u7528\u8a2d\u5b9a\u6a94\u8207\u5916\u89c0\u914d\u7f6e\uff0c\u6253\u9020\u4e00\u81f4\u7684\u684c\u9762\u98a8\u683c\u8207\u64cd\u4f5c\u9ad4\u9a57\u3002</li> </ul>"},{"location":"linux/01-linux-distributions/","title":"01 linux distributions","text":"<p>2026-10-17 Created</p>"},{"location":"linux/01-linux-distributions/#linux-distributions","title":"Linux \u767c\u884c\u7248\uff08Distributions\uff09","text":""},{"location":"linux/01-linux-distributions/#debian","title":"Debian \u7cfb","text":"\u767c\u884c\u7248 \u7279\u8272 \u57fa\u790e\uff0f\u95dc\u4fc2 Debian \u91cd\u8996\u7a69\u5b9a\u6027\uff0c\u662f\u8a31\u591a\u767c\u884c\u7248\u7684\u57fa\u790e\u3002 \u7368\u7acb\u767c\u884c\u7248 Ubuntu LTS \u8457\u91cd\u7a69\u5b9a\u6027\u8207\u9577\u671f\u652f\u63f4\uff1b\u684c\u9762\u7248\u9810\u8a2d\u4f7f\u7528 GNOME\u3002 \u57fa\u65bc Debian Linux Mint \u63d0\u4f9b\u719f\u6089\u7684\u684c\u9762\u64cd\u4f5c\u9ad4\u9a57\uff0c\u9810\u8a2d\u684c\u9762\u74b0\u5883\u901a\u5e38\u70ba Cinnamon\u3002 \u4e3b\u8981\u57fa\u65bc Ubuntu Pop!_OS \u8457\u91cd\u684c\u9762\u4f7f\u7528\u9ad4\u9a57\u8207\u751f\u7522\u529b\uff0c\u63d0\u4f9b COSMIC \u684c\u9762\u74b0\u5883\u3002 \u57fa\u65bc Ubuntu"},{"location":"linux/01-linux-distributions/#arch","title":"Arch \u7cfb","text":"\u767c\u884c\u7248 \u7279\u8272 \u57fa\u790e\uff0f\u95dc\u4fc2 Arch Linux \u57fa\u790e\u5b89\u88dd\u7cbe\u7c21\uff0c\u7531\u4f7f\u7528\u8005\u81ea\u884c\u9078\u64c7\u684c\u9762\u74b0\u5883\u8207\u7cfb\u7d71\u7d44\u4ef6\u3002 \u7368\u7acb\u767c\u884c\u7248 CachyOS \u8457\u91cd\u6548\u80fd\u8abf\u6821\u8207\u904a\u6232\u9ad4\u9a57\uff0c\u63d0\u4f9b\u591a\u7a2e\u684c\u9762\u74b0\u5883\u8207\u8996\u7a97\u7ba1\u7406\u5668\u9078\u9805\u3002 \u57fa\u65bc Arch EndeavourOS \u63d0\u4f9b\u8f03\u5bb9\u6613\u4e0a\u624b\u7684 Arch \u5b89\u88dd\u9ad4\u9a57\uff0c\u540c\u6642\u4fdd\u7559 Arch \u7684\u4f7f\u7528\u65b9\u5f0f\u3002 \u57fa\u65bc Arch Manjaro \u63d0\u4f9b\u5716\u5f62\u5316\u5b89\u88dd\u8207\u7cfb\u7d71\u7ba1\u7406\u5de5\u5177\uff0c\u964d\u4f4e\u5165\u9580\u9580\u6abb\u3002 \u57fa\u65bc Arch"},{"location":"linux/01-linux-distributions/#red-hat","title":"Red Hat \u751f\u614b\u7cfb","text":"\u767c\u884c\u7248 \u7279\u8272 \u57fa\u790e\uff0f\u95dc\u4fc2 Fedora \u66f4\u65b0\u8f03\u7a4d\u6975\uff0c\u8f03\u65e9\u63a1\u7528\u8a31\u591a\u65b0\u6280\u8853\u3002 \u7368\u7acb\u767c\u884c\u7248\uff0c\u8207 Red Hat \u751f\u614b\u7cfb\u5bc6\u5207\u76f8\u95dc"},{"location":"linux/01-linux-distributions/#_1","title":"\u5176\u4ed6\u767c\u884c\u7248","text":"\u767c\u884c\u7248 \u7279\u8272 \u57fa\u790e\uff0f\u95dc\u4fc2 Alpine Linux \u8f15\u91cf\u3001\u5b89\u5168\uff0c\u5e38\u7528\u65bc\u5bb9\u5668\u8207\u4f3a\u670d\u5668\u74b0\u5883\u3002 \u7368\u7acb\u767c\u884c\u7248 openSUSE \u63d0\u4f9b\u4e0d\u540c\u7684\u767c\u884c\u7248\u672c\u8207\u66f4\u65b0\u7b56\u7565\uff0c\u4e26\u5177\u5099\u5b8c\u6574\u7684\u7cfb\u7d71\u7ba1\u7406\u5de5\u5177\u3002 \u7368\u7acb\u767c\u884c\u7248 NixOS \u4ee5\u5ba3\u544a\u5f0f\u914d\u7f6e\u8207\u53ef\u91cd\u73fe\u7684\u7cfb\u7d71\u74b0\u5883\u8457\u7a31\u3002 \u7368\u7acb\u767c\u884c\u7248"},{"location":"linux/01-linux-distributions/#_2","title":"\u88dc\u5145\u89c0\u5ff5","text":"<ul> <li>Linux Kernel\uff08Linux \u6838\u5fc3\uff09\uff1a \u8ca0\u8cac\u7ba1\u7406\u786c\u9ad4\u3001\u8a18\u61b6\u9ad4\u3001\u7a0b\u5e8f\u7b49\u7cfb\u7d71\u8cc7\u6e90\u3002</li> <li>Linux Distribution\uff08Linux \u767c\u884c\u7248\uff09\uff1a \u5c07 Linux \u6838\u5fc3\u3001\u7cfb\u7d71\u5de5\u5177\u3001\u5957\u4ef6\u7ba1\u7406\u8207\u5176\u4ed6\u8edf\u9ad4\u6574\u5408\u6210\u53ef\u4f7f\u7528\u7684\u4f5c\u696d\u7cfb\u7d71\u3002</li> <li>Desktop Environment\uff08DE\uff0c\u684c\u9762\u74b0\u5883\uff09\uff1a \u4f8b\u5982 GNOME\u3001KDE Plasma\u3001Cinnamon\u3001COSMIC\u3002</li> <li>Window Manager\uff08WM\uff0c\u8996\u7a97\u7ba1\u7406\u5668\uff09\uff1a \u8ca0\u8cac\u7ba1\u7406\u8996\u7a97\u7684\u6392\u5217\u3001\u79fb\u52d5\u8207\u986f\u793a\uff0c\u4f8b\u5982 Hyprland\u3001Niri\u3002</li> </ul> <p>Linux \u56b4\u683c\u4f86\u8aaa\u662f\u6838\u5fc3\uff1bUbuntu\u3001Fedora\u3001Arch Linux \u7b49\u624d\u662f\u5b8c\u6574\u7684 Linux \u767c\u884c\u7248\u3002</p>"},{"location":"linux/02-linux-window-managers/","title":"02 linux window managers","text":"<p>2026-10-17 Created</p>"},{"location":"linux/02-linux-window-managers/#linux","title":"Linux \u684c\u9762\u74b0\u5883\u8207\u8996\u7a97\u7ba1\u7406\u5668","text":""},{"location":"linux/02-linux-window-managers/#_1","title":"\u684c\u9762\u74b0\u5883\u6bd4\u8f03","text":"\u540d\u7a31 \u985e\u578b \u6574\u5408\u7a0b\u5ea6 \u7279\u8272 \u9069\u5408\u5c0d\u8c61 GNOME \u684c\u9762\u74b0\u5883\uff08DE\uff09 \u9ad8 \u7c21\u6f54\u3001\u64cd\u4f5c\u4e00\u81f4\uff0c\u9810\u8a2d\u4ecb\u9762\u8f03\u504f\u5411\u6d3b\u52d5\u7e3d\u89bd\u8207\u5de5\u4f5c\u5340\u5207\u63db\u3002 \u559c\u6b61\u7c21\u6f54\u3001\u6574\u5408\u5ea6\u9ad8\u7684\u684c\u9762 Cinnamon \u684c\u9762\u74b0\u5883\uff08DE\uff09 \u9ad8 \u50b3\u7d71 Windows \u98a8\u683c\uff0c\u7c21\u55ae\u597d\u7528\u3002 \u4e00\u822c\u96fb\u8166\u3001\u60f3\u76f4\u63a5\u4f7f\u7528 KDE Plasma \u684c\u9762\u74b0\u5883\uff08DE\uff09 \u9ad8 \u50b3\u7d71\u684c\u9762\u64cd\u4f5c\u3001\u9ad8\u5ea6\u5ba2\u88fd\u5316\u3001\u5916\u89c0\u8abf\u6574\u9078\u9805\u8c50\u5bcc\u3002 \u4e00\u822c\u96fb\u8166\u3001\u559c\u6b61\u7f8e\u5316\u684c\u9762 Xfce \u684c\u9762\u74b0\u5883\uff08DE\uff09 \u9ad8 \u50b3\u7d71\u684c\u9762\u98a8\u683c\u3001\u8f15\u91cf\u3001\u5be6\u7528\u3002 \u820a\u96fb\u8166\u3001\u504f\u597d\u7c21\u6f54\u914d\u7f6e LXQt \u684c\u9762\u74b0\u5883\uff08DE\uff09 \u9ad8 \u8f15\u91cf\u3001\u50b3\u7d71\u684c\u9762\u98a8\u683c\uff0c\u8457\u91cd\u7bc0\u7701\u8cc7\u6e90\u3002 \u8cc7\u6e90\u6709\u9650\u7684\u820a\u96fb\u8166 COSMIC \u684c\u9762\u74b0\u5883\uff08DE\uff09 \u9ad8 \u73fe\u4ee3\u5316\u4ecb\u9762\u3001\u5de5\u4f5c\u5340\u7ba1\u7406\u3001\u8996\u7a97\u5e73\u92ea\u8207\u591a\u5de5\u64cd\u4f5c\u3002 \u559c\u6b61\u73fe\u4ee3\u5316\u684c\u9762\u8207\u591a\u5de5\u64cd\u4f5c Hyprland Wayland \u5408\u6210\u5668\uff0f\u8996\u7a97\u7ba1\u7406\u5668 \u4f4e \u8996\u7a97\u5e73\u92ea\u3001\u52d5\u756b\u6548\u679c\u3001\u9375\u76e4\u64cd\u4f5c\u8207\u9ad8\u5ea6\u5ba2\u88fd\u5316\u3002 \u559c\u6b61\u81ea\u5df1\u7d44\u88dd\u684c\u9762\u3001\u8ffd\u6c42\u500b\u4eba\u5316 Sway Wayland \u5408\u6210\u5668\uff0f\u8996\u7a97\u7ba1\u7406\u5668 \u4f4e \u6975\u7c21\u3001\u5e73\u92ea\u5f0f\u8996\u7a97\u7ba1\u7406\u3001\u9375\u76e4\u64cd\u4f5c\u3002 \u559c\u6b61\u7c21\u6f54\u3001\u504f\u5411 i3 \u64cd\u4f5c\u65b9\u5f0f Niri Wayland \u5408\u6210\u5668\uff0f\u8996\u7a97\u7ba1\u7406\u5668 \u4f4e \u63a1\u7528\u6c34\u5e73\u6372\u52d5\u5f0f\u8996\u7a97\u6392\u5217\uff0c\u9069\u5408\u7ba1\u7406\u5927\u91cf\u8996\u7a97\u3002 \u559c\u6b61\u4e0d\u540c\u65bc\u50b3\u7d71\u5e73\u92ea\u7684\u5de5\u4f5c\u6d41\u7a0b"},{"location":"linux/02-linux-window-managers/#_2","title":"\u6574\u5408\u7a0b\u5ea6\u7684\u5dee\u7570","text":""},{"location":"linux/02-linux-window-managers/#de","title":"\u9ad8\u6574\u5408\uff1a\u5b8c\u6574\u684c\u9762\u74b0\u5883\uff08DE\uff09","text":"<p>\u4f8b\u5982 GNOME\u3001KDE Plasma\u3001Xfce\u3001Cinnamon\u3001LXQt\u3001COSMIC\u3002</p> <p>\u901a\u5e38\u5df2\u6574\u5408\u591a\u7a2e\u684c\u9762\u529f\u80fd\uff1a</p> <ul> <li>\u8996\u7a97\u7ba1\u7406\u8207\u684c\u9762\u5de5\u4f5c\u5340</li> <li>\u9762\u677f\u3001\u5de5\u5177\u5217\u6216\u7cfb\u7d71\u6258\u76e4</li> <li>\u7cfb\u7d71\u8a2d\u5b9a\u5de5\u5177</li> <li>\u61c9\u7528\u7a0b\u5f0f\u9078\u55ae\u6216\u555f\u52d5\u4ecb\u9762</li> <li>\u901a\u77e5\u3001\u684c\u9762\u80cc\u666f\u53ca\u5176\u4ed6\u684c\u9762\u529f\u80fd</li> </ul> <p>\u5b89\u88dd\u5f8c\u901a\u5e38\u5c31\u80fd\u76f4\u63a5\u4f7f\u7528\uff0c\u4e0d\u5fc5\u81ea\u884c\u9010\u4e00\u7d44\u88dd\u6240\u6709\u684c\u9762\u5143\u4ef6\u3002</p>"},{"location":"linux/02-linux-window-managers/#_3","title":"\u4f4e\u6574\u5408\uff1a\u81ea\u884c\u7d44\u88dd\u684c\u9762","text":"<p>\u4f8b\u5982 Hyprland\u3001Sway\u3001Niri\u3002</p> <p>\u4e3b\u8981\u8ca0\u8cac\u8996\u7a97\u6392\u5217\u3001\u986f\u793a\u8207\u7ba1\u7406\uff0c\u901a\u5e38\u4e0d\u6703\u50cf\u5b8c\u6574\u684c\u9762\u74b0\u5883\u4e00\u6a23\uff0c\u5c07\u6240\u6709\u684c\u9762\u5de5\u5177\u6574\u5408\u5728\u4e00\u8d77\u3002</p> <p>\u53ef\u80fd\u9700\u8981\u53e6\u5916\u9078\u64c7\u8207\u8a2d\u5b9a\uff1a</p> <ul> <li>\u72c0\u614b\u5217\uff1a Waybar</li> <li>\u61c9\u7528\u7a0b\u5f0f\u555f\u52d5\u5668\uff1a Rofi</li> <li>\u767b\u51fa\u9078\u55ae\uff1a Wlogout</li> <li>\u901a\u77e5\u7cfb\u7d71\uff1a \u4f8b\u5982 Mako\u3001SwayNotificationCenter</li> <li>\u9396\u5b9a\u756b\u9762\uff1a \u4f8b\u5982 Hyprlock\u3001Swaylock</li> <li>\u684c\u5e03\u5de5\u5177\uff1a \u4f9d\u4f7f\u7528\u7684\u5408\u6210\u5668\u9078\u64c7</li> <li>\u87a2\u5e55\u622a\u5716\u5de5\u5177\uff1a \u4f8b\u5982 Grim\u3001Slurp</li> </ul> <p>\u5be6\u969b\u9700\u8981\u5b89\u88dd\u54ea\u4e9b\u5de5\u5177\uff0c\u53d6\u6c7a\u65bc\u6240\u4f7f\u7528\u7684\u5408\u6210\u5668\u3001\u767c\u884c\u7248\uff0c\u4ee5\u53ca\u73fe\u6210\u7684\u684c\u9762\u914d\u7f6e\u3002</p>"},{"location":"linux/02-linux-window-managers/#_4","title":"\u88dc\u5145\u89c0\u5ff5","text":"<ul> <li>\u684c\u9762\u74b0\u5883\uff08DE\uff09\uff1a \u6574\u5408\u591a\u7a2e\u684c\u9762\u529f\u80fd\uff0c\u5b89\u88dd\u5f8c\u901a\u5e38\u5c31\u80fd\u76f4\u63a5\u4f7f\u7528\u3002</li> <li>Wayland \u5408\u6210\u5668\uff08Compositor\uff09\uff1a \u8ca0\u8cac\u7ba1\u7406\u8996\u7a97\u3001\u756b\u9762\u5408\u6210\u8207\u986f\u793a\u8f38\u51fa\uff1bHyprland\u3001Sway\u3001Niri \u90fd\u5c6c\u65bc\u9019\u4e00\u985e\uff0c\u4e5f\u63d0\u4f9b\u8996\u7a97\u7ba1\u7406\u529f\u80fd\u3002</li> <li>Rice\uff0fDotfiles\uff1a \u900f\u904e\u8a2d\u5b9a\u6a94\u8abf\u6574\u5916\u89c0\u3001\u5feb\u6377\u9375\u3001\u5de5\u5177\u8207\u64cd\u4f5c\u6d41\u7a0b\u3002</li> <li>\u6574\u5408\u7a0b\u5ea6\u4e0d\u7b49\u65bc\u5ba2\u88fd\u5316\u80fd\u529b\uff1a KDE Plasma \u7684\u6574\u5408\u7a0b\u5ea6\u9ad8\uff0c\u4f46\u4ecd\u6709\u5f88\u9ad8\u7684\u5ba2\u88fd\u5316\u81ea\u7531\uff1bHyprland \u5247\u8b93\u4f7f\u7528\u8005\u66f4\u76f4\u63a5\u5730\u6c7a\u5b9a\u684c\u9762\u5143\u4ef6\u5982\u4f55\u7d44\u5408\u3002</li> </ul>"},{"location":"linux/03-linux-desktop-rice/","title":"03 linux desktop rice","text":"<p>2026-10-17 Created</p>"},{"location":"linux/03-linux-desktop-rice/#linux-shell-rice","title":"Linux \u684c\u9762\u5143\u4ef6\u3001Shell \u8207 Rice","text":""},{"location":"linux/03-linux-desktop-rice/#dotfiles","title":"\u684c\u9762\u914d\u7f6e\u5957\u4ef6\uff08Dotfiles\uff09","text":"<p>\u9019\u985e\u5c08\u6848\u901a\u5e38\u6703\u6574\u5408\u591a\u7a2e\u684c\u9762\u5de5\u5177\u3001\u8a2d\u5b9a\u6a94\u3001\u4e3b\u984c\u8207\u5feb\u6377\u9375\uff0c\u8b93\u4f7f\u7528\u8005\u5feb\u901f\u5efa\u7acb\u4e00\u5957\u5b8c\u6574\u7684\u684c\u9762\u9ad4\u9a57\u3002</p> \u540d\u7a31 \u7279\u8272 \u642d\u914d\u74b0\u5883 Caelestia Dot \u6574\u5957\u684c\u9762\u914d\u7f6e\uff0c\u5305\u542b\u684c\u9762\u4ecb\u9762\u8207\u76f8\u95dc\u8a2d\u5b9a\u3002 Hyprland illogical-impulse \u6574\u5957\u684c\u9762\u914d\u7f6e\uff0c\u8457\u91cd\u8996\u89ba\u6548\u679c\u8207\u684c\u9762\u4e92\u52d5\u3002 Hyprland end-4 \u6574\u5957\u684c\u9762\u914d\u7f6e\uff0c\u5177\u6709\u8c50\u5bcc\u7684\u684c\u9762\u4ecb\u9762\u8207\u5ba2\u88fd\u5316\u6548\u679c\u3002 Hyprland ML4W Dotfiles \u6574\u5408\u5f0f\u684c\u9762\u914d\u7f6e\uff0c\u63d0\u4f9b\u5b89\u88dd\u8207\u8a2d\u5b9a\u5de5\u5177\u3002 \u4e3b\u8981\u642d\u914d Hyprland <p>Dotfiles \u539f\u672c\u662f\u6307\u4fdd\u5b58\u7a0b\u5f0f\u8207\u7cfb\u7d71\u8a2d\u5b9a\u7684\u6a94\u6848\uff1b\u9019\u88e1\u7684\u300c\u684c\u9762\u914d\u7f6e\u5957\u4ef6\u300d\u5247\u662f\u6307\u5c07\u591a\u4efd\u8a2d\u5b9a\u8207\u76f8\u95dc\u5de5\u5177\u6574\u5408\u8d77\u4f86\u7684\u5c08\u6848\u3002</p>"},{"location":"linux/03-linux-desktop-rice/#shell","title":"\u684c\u9762 Shell","text":"<p>\u684c\u9762 Shell \u8ca0\u8cac\u63d0\u4f9b\u4f7f\u7528\u8005\u8207\u684c\u9762\u4e92\u52d5\u7684\u4ecb\u9762\uff0c\u4f8b\u5982\u9762\u677f\u3001\u9078\u55ae\u3001\u5c0f\u5de5\u5177\u53ca\u5176\u4ed6\u684c\u9762\u529f\u80fd\u3002</p> \u540d\u7a31 \u7279\u8272 \u642d\u914d\u74b0\u5883 Caelestia Shell \u63d0\u4f9b\u684c\u9762\u4e92\u52d5\u4ecb\u9762\u8207\u6574\u5408\u5f0f\u684c\u9762\u529f\u80fd\u3002 \u4e3b\u8981\u642d\u914d Hyprland"},{"location":"linux/03-linux-desktop-rice/#_1","title":"\u7279\u6b8a\u6848\u4f8b","text":"<ul> <li>Caelestia KDE\uff1a\u5c07 Caelestia Shell \u642d\u914d KDE Plasma \u4f7f\u7528\uff0c\u5c6c\u65bc\u4e0d\u540c\u65bc\u539f\u672c Hyprland \u914d\u7f6e\u7684\u6574\u5408\u65b9\u5f0f\u3002</li> </ul>"},{"location":"linux/03-linux-desktop-rice/#desktop-components","title":"\u684c\u9762\u5143\u4ef6\uff08Desktop Components\uff09","text":"<p>\u9019\u4e9b\u5de5\u5177\u901a\u5e38\u5404\u81ea\u8ca0\u8cac\u4e00\u9805\u529f\u80fd\uff0c\u53ef\u4ee5\u4f9d\u7167\u684c\u9762\u74b0\u5883\u8207\u500b\u4eba\u9700\u6c42\u9078\u64c7\u5b89\u88dd\u3002</p> \u529f\u80fd \u5de5\u5177 \u4e3b\u8981\u7528\u9014 \u72c0\u614b\u5217 Waybar \u986f\u793a\u6642\u9418\u3001\u5de5\u4f5c\u5340\u3001\u97f3\u91cf\u3001CPU \u7b49\u7cfb\u7d71\u8cc7\u8a0a\u3002 \u61c9\u7528\u7a0b\u5f0f\u555f\u52d5\u5668 Rofi \u641c\u5c0b\u7a0b\u5f0f\u3001\u555f\u52d5\u61c9\u7528\u7a0b\u5f0f\u53ca\u5efa\u7acb\u81ea\u8a02\u9078\u55ae\u3002 \u8996\u7a97\u5408\u6210\u5668 Picom \u70ba\u8996\u7a97\u52a0\u5165\u900f\u660e\u5ea6\u3001\u9670\u5f71\u7b49\u8996\u89ba\u6548\u679c\uff0c\u4e3b\u8981\u7528\u65bc X11\u3002 \u96fb\u6e90\u63a7\u5236\u9078\u55ae Wlogout \u63d0\u4f9b\u95dc\u6a5f\u3001\u91cd\u65b0\u555f\u52d5\u3001\u767b\u51fa\u7b49\u9078\u9805\u3002"},{"location":"linux/03-linux-desktop-rice/#rice","title":"Rice\uff08\u684c\u9762\u500b\u4eba\u5316\u914d\u7f6e\uff09","text":"<p>Rice \u6307\u7684\u662f\u5c0d\u684c\u9762\u5916\u89c0\u8207\u64cd\u4f5c\u65b9\u5f0f\u9032\u884c\u500b\u4eba\u5316\u8abf\u6574\u7684\u6210\u679c\uff1bRicing \u5247\u662f\u8abf\u6574\u8207\u7f8e\u5316\u684c\u9762\u7684\u904e\u7a0b\u3002</p>"},{"location":"linux/03-linux-desktop-rice/#visual","title":"\u5916\u89c0\u914d\u7f6e\uff08Visual\uff09","text":"\u9805\u76ee \u8aaa\u660e GTK \u4e3b\u984c \u8abf\u6574\u61c9\u7528\u7a0b\u5f0f\u7684\u4ecb\u9762\u98a8\u683c\u3002 \u8996\u7a97\u88dd\u98fe \u8abf\u6574\u8996\u7a97\u908a\u6846\u3001\u6a19\u984c\u5217\u7b49\u5916\u89c0\u3002 App Icon \u7d71\u4e00\u61c9\u7528\u7a0b\u5f0f\u5716\u793a\u98a8\u683c\u3002 \u6e38\u6a19 \u8abf\u6574\u6ed1\u9f20\u6e38\u6a19\u7684\u5916\u89c0\u3002 \u5b57\u578b \u82f1\u6587:JetBrains Mono\u3001\u4e2d\u6587:\u601d\u6e90\u9ed1\u9ad4 \u684c\u5e03 \u8a2d\u5b9a\u684c\u9762\u80cc\u666f\u3002 \u8996\u89ba\u6548\u679c \u80cc\u666f\u6a21\u7cca\u3001\u900f\u660e\u5ea6\u3001\u9670\u5f71\u3001\u52d5\u756b\u7b49\u3002"},{"location":"linux/03-linux-desktop-rice/#interaction","title":"\u64cd\u4f5c\u914d\u7f6e\uff08Interaction\uff09","text":"\u9805\u76ee \u8aaa\u660e \u5feb\u6377\u9375 \u8a2d\u5b9a\u958b\u555f\u7a0b\u5f0f\u3001\u5207\u63db\u8996\u7a97\u8207\u7cfb\u7d71\u64cd\u4f5c\u7684\u6309\u9375\u3002 \u8996\u7a97\u6392\u5217 \u8a2d\u5b9a\u5e73\u92ea\u3001\u6d6e\u52d5\u8207\u8996\u7a97\u5c3a\u5bf8\u3002 \u5de5\u4f5c\u5340 \u8a2d\u5b9a\u5de5\u4f5c\u5340\u5207\u63db\u8207\u8996\u7a97\u5206\u914d\u65b9\u5f0f\u3002 \u9762\u677f\u884c\u70ba \u8a2d\u5b9a\u9762\u677f\u81ea\u52d5\u96b1\u85cf\u3001\u4f4d\u7f6e\u8207\u986f\u793a\u65b9\u5f0f\u3002 \u6ed1\u9f20\u64cd\u4f5c \u8a2d\u5b9a\u62d6\u66f3\u8996\u7a97\u3001\u624b\u52e2\u8207\u5176\u4ed6\u4e92\u52d5\u65b9\u5f0f\u3002"},{"location":"linux/03-linux-desktop-rice/#dotfiles-github-rice-repo","title":"Dotfiles \u8207 GitHub Rice Repo","text":"<ul> <li>Dotfiles\uff1a \u4fdd\u5b58\u684c\u9762\u3001\u7d42\u7aef\u6a5f\u3001\u7de8\u8f2f\u5668\u53ca\u5176\u4ed6\u7a0b\u5f0f\u7684\u8a2d\u5b9a\u6a94\u3002</li> <li>GitHub Rice Repo\uff1a \u4ed6\u4eba\u516c\u958b\u5206\u4eab\u7684\u684c\u9762\u914d\u7f6e\u3001\u8a2d\u5b9a\u6a94\u3001\u5b89\u88dd\u8173\u672c\u8207\u4e3b\u984c\u8cc7\u6e90\u3002</li> <li>\u81ea\u884c\u914d\u7f6e\uff1a \u81ea\u5df1\u6311\u9078\u684c\u9762\u5143\u4ef6\u3001\u5916\u89c0\u4e3b\u984c\u8207\u64cd\u4f5c\u65b9\u5f0f\uff0c\u9010\u6b65\u5efa\u7acb\u500b\u4eba\u5316\u684c\u9762\u3002</li> <li>\u5957\u7528\u73fe\u6210\u914d\u7f6e\uff1a \u4f7f\u7528\u6574\u5408\u5f0f Dotfiles \u5c08\u6848\uff0c\u6e1b\u5c11\u9010\u4e00\u5b89\u88dd\u8207\u8a2d\u5b9a\u7684\u5de5\u4f5c\u3002</li> </ul>"},{"location":"linux/03-linux-desktop-rice/#applications","title":"\u4e00\u822c\u61c9\u7528\u7a0b\u5f0f\uff08Applications\uff09","text":"<p>\u4e00\u822c\u61c9\u7528\u7a0b\u5f0f\u8ca0\u8cac\u65e5\u5e38\u5de5\u4f5c\uff0c\u4e0d\u5c6c\u65bc\u684c\u9762\u5143\u4ef6\u6216 Rice \u672c\u8eab\u3002\u5b83\u5011\u53ef\u4ee5\u642d\u914d\u4efb\u4f55\u9069\u5408\u7684\u684c\u9762\u74b0\u5883\u4f7f\u7528\u3002</p> \u985e\u5225 \u4f8b\u5b50 \u7a0b\u5f0f\u7de8\u8f2f\u5668 VS Code \u7d42\u7aef\u6a5f Kitty\u3001Alacritty Shell Zsh\u3001Fish \u6587\u4ef6\u7de8\u8f2f ONLYOFFICE \u700f\u89bd\u5668 \u4f9d\u9700\u6c42\u9078\u64c7 <p>\u684c\u9762\u914d\u7f6e\u53ef\u4ee5\u5305\u542b\u61c9\u7528\u7a0b\u5f0f\u7684\u5b89\u88dd\u8207\u8a2d\u5b9a\uff0c\u4f46\u61c9\u7528\u7a0b\u5f0f\u672c\u8eab\u4ecd\u662f\u7368\u7acb\u7684\u8edf\u9ad4\u985e\u5225\u3002</p>"},{"location":"linux/04-linux-applications/","title":"04 linux applications","text":"<p>2026-10-17 Created</p>"},{"location":"linux/04-linux-applications/#linux-applications","title":"Linux Applications\uff08\u61c9\u7528\u7a0b\u5f0f\uff09","text":""},{"location":"linux/04-linux-applications/#development-tools","title":"\u958b\u767c\u5de5\u5177\uff08Development Tools\uff09","text":"\u985e\u5225 \u8edf\u9ad4 \u7279\u8272\uff0f\u7528\u9014 \u7a0b\u5f0f\u7de8\u8f2f\u5668 VS Code \u7de8\u8f2f\u7a0b\u5f0f\u78bc\u8207\u7ba1\u7406\u958b\u767c\u5c08\u6848\u3002 \u7248\u672c\u63a7\u5236 Git \u7ba1\u7406\u7a0b\u5f0f\u78bc\u7248\u672c\u8207\u8b8a\u66f4\u7d00\u9304\u3002"},{"location":"linux/04-linux-applications/#terminal-cli","title":"\u7d42\u7aef\u6a5f\u8207\u547d\u4ee4\u5217\uff08Terminal &amp; CLI\uff09","text":"\u985e\u5225 \u8edf\u9ad4 \u7279\u8272\uff0f\u7528\u9014 Shell Zsh \u529f\u80fd\u8c50\u5bcc\uff0c\u53ef\u642d\u914d Oh My Zsh\u3001Powerlevel10k\u3002 Shell Fish \u63d0\u4f9b\u53cb\u5584\u7684\u4e92\u52d5\u5f0f\u547d\u4ee4\u5217\u9ad4\u9a57\u3002 \u7d42\u7aef\u6a5f Kitty \u529f\u80fd\u8c50\u5bcc\u7684\u7d42\u7aef\u6a5f\u6a21\u64ec\u5668\u3002 \u7d42\u7aef\u6a5f Alacritty \u8457\u91cd\u6548\u80fd\u8207\u7cbe\u7c21\u8a2d\u8a08\u7684\u7d42\u7aef\u6a5f\u6a21\u64ec\u5668\u3002 \u7d42\u7aef\u6a5f\u5206\u5272\u8207\u5de5\u4f5c\u968e\u6bb5\u7ba1\u7406 tmux \u5728\u7d42\u7aef\u6a5f\u4e2d\u7ba1\u7406\u591a\u500b\u7a97\u683c\u8207\u5de5\u4f5c\u968e\u6bb5\u3002 \u6a21\u7cca\u641c\u5c0b fzf \u5feb\u901f\u641c\u5c0b\u6a94\u6848\u3001\u547d\u4ee4\u6b77\u53f2\u8207\u5176\u4ed6\u6e05\u55ae\u3002"},{"location":"linux/04-linux-applications/#system-monitoring","title":"\u7cfb\u7d71\u76e3\u63a7\uff08System Monitoring\uff09","text":"\u985e\u5225 \u8edf\u9ad4 \u7279\u8272\uff0f\u7528\u9014 \u786c\u9ad4\u8207\u7cfb\u7d71\u76e3\u63a7 btop \u67e5\u770b CPU\u3001\u8a18\u61b6\u9ad4\u3001\u78c1\u789f\u8207\u7a0b\u5e8f\u7b49\u8cc7\u8a0a\u3002 \u7cfb\u7d71\u8cc7\u8a0a fastfetch \u5728\u7d42\u7aef\u6a5f\u986f\u793a\u7cfb\u7d71\u8207\u786c\u9ad4\u8cc7\u8a0a\u3002"},{"location":"linux/04-linux-applications/#files-documents","title":"\u6a94\u6848\u8207\u6587\u4ef6\u8655\u7406\uff08Files &amp; Documents\uff09","text":"\u985e\u5225 \u8edf\u9ad4 \u7279\u8272\uff0f\u7528\u9014 \u8fa6\u516c\u8edf\u9ad4 ONLYOFFICE \u7de8\u8f2f\u6587\u4ef6\u3001\u8a66\u7b97\u8868\u8207\u7c21\u5831\u3002"},{"location":"linux/04-linux-applications/#web-browsers","title":"\u7db2\u8def\u8207\u700f\u89bd\u5668\uff08Web &amp; Browsers\uff09","text":"\u985e\u5225 \u8edf\u9ad4 \u7279\u8272\uff0f\u7528\u9014 \u700f\u89bd\u5668 Helium \u7db2\u9801\u700f\u89bd\u5de5\u5177\uff0c\u4e4b\u5f8c\u53ef\u88dc\u5145\u5b89\u88dd\u65b9\u5f0f\u8207\u7279\u8272\u3002"},{"location":"linux/04-linux-applications/#_1","title":"\u5f85\u7814\u7a76\u9805\u76ee","text":"<ul> <li>[ ] \u6bd4\u8f03\u4e0d\u540c\u7d42\u7aef\u6a5f\u6a21\u64ec\u5668\u3002</li> <li>[ ] \u6bd4\u8f03 Zsh \u8207 Fish \u7684\u4f7f\u7528\u5dee\u7570\u3002</li> <li>[ ] \u6574\u7406\u5e38\u7528\u547d\u4ee4\u5217\u5de5\u5177